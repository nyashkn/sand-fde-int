digraph recon {
  rankdir=LR;
  // ── Deliverable 0: pre-engagement recon deep-dive ──────────────────────────────
  // A MECE technical deep-research of ANY target organisation's digital landscape,
  // ending in a self-contained html-kit artifact (systems map, persona journeys,
  // integration/data-flow, data-protection posture).
  //
  // Reusing this for a new engagement: edit recon.toml's [run] goal to name your
  // TARGET and sector, and (optionally) add domain seed-terms to each lane's FOCUS
  // line where marked `SEED:`. Everything else is target-agnostic.
  //
  // Structure notes (fabro 0.316): `halt` is a plain exit-1 sink, NOT a goal_gate
  // (an unvisited goal_gate fails the whole run); the single goal_gate lives on the
  // always-visited `coverage` node. Parallel lanes edge into `join` UNCONDITIONALLY;
  // per-lane success is enforced by the coverage gate. See ../README.md.
  graph [
    // Workhorse = a cheap, fast model; heavy lanes + synth = a stronger model;
    // the visual artifact = a strong long-output model. Swap these for your provider.
    model_stylesheet="* { model: deepseek-v4-flash; } .heavy { model: minimax-m3; } .visual { model: kimi-k3; }",
    default_max_retries=2
  ];

  start [shape=Mdiamond, label="Start"];
  exit  [shape=Msquare,  label="Exit"];
  halt  [shape=parallelogram, script="echo 'recon failed at an upstream node' >&2; exit 1"];
  halt -> exit;

  preflight [shape=parallelogram, label="Preflight (mkdir out)", script="mkdir -p out out/.raw"];

  // ── Scope: turn the engagement question into 7 MECE lane briefs (no research yet) ──
  scope [
    label="Scope (MECE lanes)",
    prompt="Research goal: {{ goal }}\n\nProduce a MECE research plan for the TARGET organisation named in the goal, covering EXACTLY these 7 lanes: (1) systems internal+external, (2) where each is deployed, (3) vendors incl AI, (4) data-protection approach inside those systems, (5) personas and their end-to-end journeys, (6) how the disparate systems/services integrate, (7) the jurisdiction's data-protection law + how comparable organisations solved it. Write out/00-scope.md: per lane, the key sub-questions and candidate systems/vendors/keywords to search. Lanes must be mutually exclusive, collectively exhaustive. Do NOT research yet — plan only."
  ];

  fan [shape=component, label="Fan-out: 7 research lanes"];

  lane_systems [
    label="L1 Systems (internal+external)",
    prompt="Follow the deep-web-search skill (call use_skill('deep-web-search') first). LANE = systems.\nFOCUS: Every significant software/data system the TARGET (see goal) runs or relies on — internal systems of record, operational tools, data platforms, registries — and external/partner/donor platforms it depends on. For each: purpose, owner, current status. SEED: add the target's known core systems here per engagement.\nTHEN double-click the 3-5 most central systems: architecture, modules, who uses them.\nWrite out/01-systems.md with inline source URLs."
  ];
  lane_deploy [
    label="L2 Deployment",
    prompt="Follow the deep-web-search skill (use_skill('deep-web-search')). LANE = deployment.\nFOCUS: Where each system of the TARGET is deployed — national/central data centre, cloud (which provider/region), on-prem/facility, edge, mobile/offline-first. Hosting, connectivity assumptions, and the org's tiering (central/regional/local/field).\nTHEN double-click the deployment topology of the 2-3 backbone systems.\nWrite out/02-deployment.md with inline source URLs."
  ];
  lane_vendors [
    label="L3 Vendors + AI",
    prompt="Follow the deep-web-search skill (use_skill('deep-web-search')). LANE = vendors.\nFOCUS: Vendors and implementing partners the TARGET uses, EMPHASIS on AI vendors (automation, prediction/forecasting, assistants/chatbots, decision support, imaging/vision where relevant). Who supplies what; contract/grant context if public.\nTHEN double-click each AI vendor: product, integration point, data used.\nWrite out/03-vendors.md with inline source URLs."
  ];
  lane_dp_approach [
    label="L4 Data-protection approach",
    prompt="Follow the deep-web-search skill (use_skill('deep-web-search')). LANE = dp_approach.\nFOCUS: How the TARGET's deployed systems actually handle data protection in practice — consent capture, de-identification, access control, data residency, audit logging, encryption at rest/in transit.\nTHEN double-click 2-3 systems' concrete data-protection design.\nWrite out/04-dp-approach.md with inline source URLs."
  ];
  lane_personas [
    label="L5 Personas + journeys",
    class="heavy",
    prompt="Follow the deep-web-search skill (use_skill('deep-web-search')). LANE = personas.\nFOCUS: The personas across the TARGET's stack — from leadership/policy down to frontline/field users and the end beneficiaries/customers. For each: goals, the systems they touch, and their end-to-end journey. This lane feeds the persona map in the final artifact. SEED: list the target's actual roles per engagement.\nWrite out/05-personas.md — one clear journey per persona, with inline source URLs."
  ];
  lane_integration [
    label="L6 Integration + data-flow",
    class="heavy",
    prompt="Follow the deep-web-search skill (use_skill('deep-web-search')). LANE = integration.\nFOCUS: How the TARGET's disparate systems connect — any information-exchange / interoperability layer, integration standards and APIs, shared records, master registries, and messaging. Describe which system sends what data to which.\nTHEN double-click the interoperability layer.\nWrite out/06-integration.md — include an explicit list of data-flow edges (source -> destination : payload), with inline source URLs."
  ];
  lane_dp_law [
    label="L7 DP law + benchmark",
    class="heavy",
    prompt="Follow the deep-web-search skill (use_skill('deep-web-search')). LANE = dp_law.\nFOCUS: The TARGET jurisdiction's data-protection law (name the statute + regulator; cross-border transfer rules; DPO obligations; sector-specific data rules). SEED: name the specific law per engagement.\nTHEN benchmark: how do comparable organisations / platforms architect for such laws — data residency, consent, access control (e.g. ReBAC), audit, DPO, breach handling. Double-click 2-3 benchmark approaches.\nWrite out/07-dp-law.md with inline source URLs."
  ];

  join [shape=tripleoctagon, label="Join 7 lanes"];

  synth [
    label="Synthesize MECE model",
    class="heavy",
    prompt="Read out/00-scope.md and out/01-systems.md .. out/07-dp-law.md. Produce out/08-synthesis.md — a single MECE model of the TARGET's digital landscape:\n(a) systems inventory TABLE (system | purpose | owner | deployment | vendor | DP posture),\n(b) per-persona journeys,\n(c) systems map (nodes + relationships),\n(d) integration / data-flow edges (source -> destination : payload),\n(e) data-protection-law constraints mapped to how each system/benchmark solves them.\nFlag gaps and a confidence level per section. Keep every claim's source URL inline. This file is the SINGLE source the visual artifact renders."
  ];

  html [
    label="Render html-kit artifact",
    class="visual",
    prompt="Read out/08-synthesis.md, then call use_skill('html-artifact') and follow it exactly. Produce out/architecture.html — one self-contained page (inline CSS/SVG, no external assets) with sections: (1) executive summary, (2) systems map, (3) persona journeys (one lane per persona), (4) integration & data-flow diagram, (5) data-protection posture vs the jurisdiction's law. After writing, confirm the file exists and is substantial."
  ];

  coverage [shape=parallelogram, goal_gate=true, label="Coverage gate (MECE)",
    script="for f in 01-systems 02-deployment 03-vendors 04-dp-approach 05-personas 06-integration 07-dp-law 08-synthesis; do test -s out/$f.md || { echo \"MISSING out/$f.md\" >&2; exit 1; }; done; test -s out/architecture.html || { echo 'MISSING html artifact' >&2; exit 1; }; echo 'coverage ok'"];

  start -> preflight;
  preflight -> scope [condition="outcome=succeeded"]; preflight -> halt;
  scope     -> fan   [condition="outcome=succeeded"]; scope     -> halt;

  fan -> lane_systems;
  fan -> lane_deploy;
  fan -> lane_vendors;
  fan -> lane_dp_approach;
  fan -> lane_personas;
  fan -> lane_integration;
  fan -> lane_dp_law;

  lane_systems     -> join;
  lane_deploy      -> join;
  lane_vendors     -> join;
  lane_dp_approach -> join;
  lane_personas    -> join;
  lane_integration -> join;
  lane_dp_law      -> join;

  join     -> synth    [condition="outcome=succeeded"]; join     -> halt;
  synth    -> html     [condition="outcome=succeeded"]; synth    -> halt;
  html     -> coverage [condition="outcome=succeeded"]; html     -> halt;
  coverage -> exit     [condition="outcome=succeeded"]; coverage -> halt;
}
