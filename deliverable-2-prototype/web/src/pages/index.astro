---
/**
 * Landing page, not a bulletin edition.
 *
 * `dist/index.html` used to be a full `<Bulletin>` render at `process.env.QUARTER`, so the
 * deployed site root was a second ~142 KB copy of whichever quarter happened to be last
 * built, with no signal to a visitor that three other quarters exist. This page replaces
 * that: it carries no quarter of its own, so it cannot drift the way `process.env.QUARTER`
 * once did (see the comment this file used to carry, preserved in git history), and it
 * links out to the four real editions instead of rendering one of them.
 *
 * The four editions themselves are unaffected: `src/pages/[quarter].astro` still builds
 * `dist/2024-Q1.html` etc. via `getStaticPaths`, unchanged by this file.
 */
import '../styles/bulletin.css';
import { ALL_QUARTERS, headlineNmr, completeness } from '../lib/mart';

const editions = await Promise.all(ALL_QUARTERS.map(async (quarter) => {
  const [head, comp] = await Promise.all([headlineNmr(quarter), completeness(quarter)]);
  const absent = comp.filter((c) => c.state === 'absent').map((c) => c.period);
  const contested = comp.filter((c) => c.state === 'contested').map((c) => c.period);
  const bits = [];
  if (absent.length) bits.push(`${absent.join(', ')} absent`);
  if (contested.length) bits.push(`batch conflict in ${contested.join(', ')}`);
  return {
    quarter,
    rate: head.rate,
    note: bits.length ? bits.join(', ') : 'complete quarter, no batch conflicts',
  };
}));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Quarterly Health Bulletin (synthetic data)</title>
</head>
<body>
<div class="page" id="top">

  <!-- Synthetic-data disclosure: first content element, same wording and markup as the
       bulletin's own `.synthetic-notice` block, so this reads as one artifact with the
       four editions it links to, not a separate unbadged surface. -->
  <div class="synthetic-notice">
    Synthetic data, built for a Sand Technologies recruitment exercise. This is not an
    official Ministry of Health, Rwanda publication: every figure reachable from this page
    is fabricated and does not describe a real health outcome.
  </div>

  <header class="masthead">
    <div class="kicker">Ministry of Health, Rwanda &middot; neonatal &middot; quarterly bulletin</div>
    <h1>Quarterly Health Bulletin</h1>
  </header>

  <section class="deep">
    <h2><span class="n">About</span>What this is</h2>
    <p>
      A Quarterly Health Bulletin prototype, built for a Sand Technologies Forward
      Deployed Engineer assignment. Every figure reachable from this page is produced end
      to end from five source CSVs (facility registry, clinical neonatal records,
      facility capability, referrals, and a DHIS2 sample), through one reproducible
      pipeline, to static HTML: nothing is edited by hand between the data and what you
      read. The site itself ships zero client-side JavaScript; every chart, table, and
      figure is rendered at build time.
    </p>
  </section>

  <section class="deep">
    <h2><span class="n">Editions</span>Four quarterly editions, 2024</h2>
    <p>
      Each edition covers one quarter, resolved independently from the same pipeline.{' '}
      <b>2024-Q1</b> is the quarter the written submission discusses: it carries both an
      unresolved batch conflict and a missing month, so it is the edition that exercises
      every caveat the build has. Start there if you are reading only one.
    </p>
    <div class="receipts" style="border-bottom:none;">
      {editions.map((e) => (
        <div class="receipt">
          <div class="k">{e.quarter}{e.quarter === '2024-Q1' ? ', start here' : ''}</div>
          <div class="v good"><a href={`/${e.quarter}`}>{e.rate.toFixed(1)}</a></div>
          <div class="d">{e.note}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="deep">
    <h2><span class="n">Email</span>Email edition</h2>
    <p>
      A short, chart-free summary built for clients that cannot render inline SVG (Gmail,
      Outlook, and Yahoo drop it): <a href="/email.html">read the email edition</a>.
    </p>
  </section>

  <section class="deep">
    <h2><span class="n">Source</span>Repository</h2>
    <p>
      Pipeline, checks, and every source document behind this bulletin are in the
      repository: <a href="https://github.com/nyashkn/sand-fde-int">github.com/nyashkn/sand-fde-int</a>.
    </p>
  </section>

  <footer class="colophon">
    Generated from <code>assignment_csv</code> and <code>dhis2</code><br />
    Pipeline <code>run.py</code> (Hamilton, DuckDB, Parquet) &middot; site Astro, zero client JavaScript
  </footer>

</div>
</body>
</html>
